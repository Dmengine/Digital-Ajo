{
  "expo": {
    "name": "contripay",
    "slug": "contripay",
    "version": "1.0.0",
    "scheme": "contripay",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.oladimeji440.contripaymobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "https://digital-ajo.onrender.com/api",
      "eas": {
        "projectId": "e27f8b35-2493-4aca-bd72-6728d223ad69"
      },
      "privacyUrl": ""
    },
    "owner": "oladimeji440",
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
